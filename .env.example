# Razorpay (use TEST keys first: Dashboard > Account & Settings > API Keys)
RZP_KEY_ID=rzp_test_xxxxxxxx
RZP_KEY_SECRET=xxxxxxxx
# Dashboard > Webhooks (events: payment.captured, order.paid)
RZP_WEBHOOK_SECRET=choose-a-long-random-string
# Protects the /api/admin/* routes (dispute resolution)
ADMIN_TOKEN=choose-another-long-random-string
FEE_PERCENT=2
# Days the seller's money stays on hold if the buyer does nothing
HOLD_DAYS=3
PORT=3000

# --- AI agent (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxx
ANTHROPIC_MODEL=claude-sonnet-5-5
PUBLIC_URL=https://your-domain.com
# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=choose-a-string
WA_APP_SECRET=

# SQLite file (default ./vend.db)
DB_FILE=./vend.db

# --- Public number shown on listing pages (digits with country code, e.g. 919876543210) ---
WA_BUSINESS_NUMBER=
# --- Meta Ads (optional). Ads are created PAUSED. ---
META_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_MAX_DAILY_INR=500
# --- Tenant verification provider (default: manual review) ---
VERIFY_PROVIDER=manual
